# VERO ERP — .env de PRODUÇÃO (exemplo).
# Parser MANUAL (config/database.php + config/database_uni.php): KEY=VALUE, uma por
# linha, sem aspas obrigatórias, '#' = comentário. ATENÇÃO: só as chaves DB_*, UNI_DB_*
# e OPENAI_*/IA_BASE_URL são lidas DESTE ARQUIVO. As demais (bloco final, comentado)
# precisam ser VARIÁVEIS DE AMBIENTE REAIS do processo (nenhum bootstrap as carrega do .env).

# --- Banco principal (config/database.php) ---
# DSN é montado SEM porta -> o MySQL TEM que estar na 3306. charset é hardcoded utf8mb4.
# Runtime = vero_app (SELECT/INSERT/UPDATE/DELETE, SEM DDL).
DB_HOST=mysql
DB_NAME=vero_db
DB_USER=vero_app
DB_PASS=__CHANGE_ME__

# --- Universidade VERO — BANCO SEPARADO (config/database_uni.php) ---
UNI_DB_HOST=mysql
UNI_DB_NAME=vero_universidade
UNI_DB_USER=vero_app
UNI_DB_PASS=__CHANGE_ME__

# --- IA / app de campo (api/v1/rotas/ia.php) — lidas do .env OU de env var (getenv com fallback) ---
OPENAI_API_KEY=__CHANGE_ME__
IA_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODELO_CHAT=openai/gpt-oss-120b
OPENAI_MODELO_STT=whisper-large-v3

# ===================================================================================
# ABAIXO: NÃO são lidas deste arquivo — injete como env vars REAIS no container.
# ===================================================================================
# APP_ENV=production
# BIOS_LOG_DIR=/var/www/vero/logs         # OBRIGATÓRIO: senão o log cai em /var/logs (fora do open_basedir) e falha
# BIOS_CURL_CAINFO=/etc/ssl/certs/ca-certificates.crt
# IA_AGENTE_BASE_URL=https://api.groq.com/openai/v1
# ANTHROPIC_API_KEY=__CHANGE_ME__         # opcional — só p/ importação de laudos de nutrição
# UPLOAD_MAX_SIZE=5242880                 # 5 MB (default do código)
# BCRYPT_COST=12
# BIOS_CRYPTO_KEY=__CHANGE_ME__           # 32 bytes em base64 (AES-256-GCM — includes/crypto.php)
# BIOS_SECRET_KEY=__CHANGE_ME__           # 32 bytes em base64 (includes/security/SecretBox.php)
# TELEGRAM_BOT_TOKEN=__CHANGE_ME__        # opcional — scripts/telegram_enviar.php
# TELEGRAM_CHAT_ID=__CHANGE_ME__          # opcional — scripts/telegram_enviar.php

# ===================================================================================
# PASSO DE MIGRAÇÃO (separado): usar um .env alternativo com o usuário vero_migrate
# (CREATE/ALTER/DROP/INDEX), porque migrar.sh e migrations/*.php leem config/database.php.
#   DB_USER=vero_migrate ; DB_PASS=__CHANGE_ME__   (mesmo DB_HOST/DB_NAME)
# ===================================================================================
