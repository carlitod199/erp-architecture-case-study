# ── Credenciais e segredos — NUNCA versionar ─────────────────
.env
.env.*
!.env.example
config/fiscal_secrets.php
config/.env

# Chaves, certificados e credenciais de serviços
*.pem
*.key
*.pfx
*.p12
credentials.json
service-account.json
secrets/
private/
config.local.*
config.production.*

# ── Dados de runtime (nunca pertencem ao repositório) ────────
/storage/*
!/storage/certs/
/storage/certs/*
!/storage/certs/.gitignore
/storage_private/
/logs/
/uploads/
/tests/bateria/_out/
site/leads/*.csv

# ── Backups, dumps e pacotes ─────────────────────────────────
/_backups_implementacao/
*.sql.gz
*.dump
*.bak
*.old
*.backup
*.rar
*.zip
*.tar.gz
*.tgz
*.apk
*.sha256
deploy/_local/

# ── Dependências (reconstruídas por composer/npm install) ────
/vendor/
node_modules/
vero_campo/.expo/
vero_campo/dist/

# ── SO / editor / ferramentas ────────────────────────────────
Thumbs.db
.DS_Store
.idea/
.vscode/
*.log
