{
  "id": "compra.rejeitar",
  "titulo": "Rejeitar um pedido de compra",
  "modulo": "compras",
  "permissao": "compras.aprovacoes.editar",
  "tipo": "escrita",
  "confirmar": true,
  "handler": { "metodo": "POST", "rota": "/compras/pedidos/{id}/rejeitar", "funcao": "rota_compra_decidir" },
  "params": {
    "id": { "tipo": "int", "obrigatorio": true, "resolver": null, "desc": "id do pedido em aprovação", "de_contexto": true },
    "client_uuid": { "tipo": "texto", "obrigatorio": true, "resolver": null, "desc": "id da decisão no aparelho (idempotência)", "de_contexto": true },
    "observacao": { "tipo": "texto", "obrigatorio": false, "resolver": null, "desc": "motivo da rejeição (máx. 255)" }
  },
  "resumo": "Rejeitar pedido de compra #{id}",
  "regras": [
    "o pedido precisa estar aguardando aprovação (status 'aprovacao')",
    "rejeita a aprovação pendente e devolve o pedido para 'rascunho'"
  ],
  "inverso": "compra.aprovar"
}
