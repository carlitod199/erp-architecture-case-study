{
  "id": "compras_solicitacoes.sync",
  "titulo": "Listar solicitações de compra (SC) e itens",
  "modulo": "compras",
  "permissao": "compras.ver",
  "tipo": "leitura",
  "confirmar": false,
  "handler": { "metodo": "GET", "rota": "/sync/compras_solicitacoes", "funcao": "rota_sync" },
  "params": {
    "desde": { "tipo": "data", "obrigatorio": false, "resolver": null, "desc": "cursor de delta; ausente = carga cheia", "de_contexto": true }
  },
  "resumo": "Solicitações de compra e status (delta desde {desde})",
  "regras": [
    "handler exige compras.ver",
    "cada solicitação carrega seus itens (produto/descrição/quantidade)"
  ],
  "inverso": null
}
